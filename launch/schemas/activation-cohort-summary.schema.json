{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/OthmaneBlial/pdf-editor-offline/main/launch/schemas/activation-cohort-summary.schema.json",
  "title": "PDF Editor Offline public activation cohort summary",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "cohort_id",
    "release_version",
    "privacy",
    "eligible_fresh_machine_testers",
    "successful_five_minute_workflows",
    "success_rate",
    "median_workflow_seconds",
    "platform_counts",
    "blocker_categories",
    "blocker_severity",
    "broad_launch_gate",
    "content_included"
  ],
  "properties": {
    "schema": { "const": "pdf-editor-offline.activation-cohort-summary" },
    "schema_version": { "const": "1.0.0" },
    "cohort_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "release_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "privacy": {
      "type": "object",
      "required": ["contains_tester_ids", "contains_document_data", "contains_free_text"],
      "properties": {
        "contains_tester_ids": { "const": false },
        "contains_document_data": { "const": false },
        "contains_free_text": { "const": false }
      },
      "additionalProperties": false
    },
    "eligible_fresh_machine_testers": { "type": "integer", "minimum": 0, "maximum": 20 },
    "successful_five_minute_workflows": { "type": "integer", "minimum": 0, "maximum": 20 },
    "success_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "median_workflow_seconds": { "type": ["number", "null"], "minimum": 0, "maximum": 3600 },
    "platform_counts": {
      "type": "object",
      "required": ["windows-x64", "macos-arm64", "macos-x64", "linux-x64"],
      "properties": {
        "windows-x64": { "type": "integer", "minimum": 1, "maximum": 20 },
        "macos-arm64": { "type": "integer", "minimum": 1, "maximum": 20 },
        "macos-x64": { "type": "integer", "minimum": 1, "maximum": 20 },
        "linux-x64": { "type": "integer", "minimum": 1, "maximum": 20 }
      },
      "additionalProperties": false
    },
    "blocker_categories": {
      "type": "object",
      "propertyNames": {
        "enum": ["wrong_asset", "signature", "permissions", "startup", "discoverability", "fidelity", "performance", "crash", "other"]
      },
      "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 20 }
    },
    "blocker_severity": {
      "type": "object",
      "properties": {
        "P0": { "type": "integer", "minimum": 1, "maximum": 20 },
        "P1": { "type": "integer", "minimum": 1, "maximum": 20 },
        "P2": { "type": "integer", "minimum": 1, "maximum": 20 }
      },
      "additionalProperties": false
    },
    "broad_launch_gate": {
      "type": "object",
      "required": [
        "minimum_testers",
        "minimum_success_rate",
        "zero_p0_blockers",
        "required_platforms",
        "platform_coverage_passed",
        "passed"
      ],
      "properties": {
        "minimum_testers": { "const": 10 },
        "minimum_success_rate": { "const": 0.8 },
        "zero_p0_blockers": { "const": true },
        "required_platforms": {
          "const": ["linux-x64", "macos-arm64", "macos-x64", "windows-x64"]
        },
        "platform_coverage_passed": { "type": "boolean" },
        "passed": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "content_included": { "const": false }
  },
  "additionalProperties": false
}
